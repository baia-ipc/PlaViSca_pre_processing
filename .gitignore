# Intermediate Seurat objects (large binaries — not version-controlled)
*.rds
*.RDS

# Raw count matrices (STARsolo output — very large)
counts/

# Knee-plot PDFs (generated outputs)
*_knee_plots.pdf

# Supplementary data files (binary/Excel — managed separately)
data/*.rds
data/*.xls
data/*.xlsx
data/*.txt
data/*.csv

# Pixi environment cache
scripts/.pixi/
scripts/pixi.lock

# R session artifacts
.Rhistory
.RData
.Rproj.user/

# OS files
.DS_Store
Thumbs.db

# Personal Claude Code permission overrides (not shared with the team)
.claude/settings.local.json

# Stray default R plotting device output
Rplots.pdf
